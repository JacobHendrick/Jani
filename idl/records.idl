record component_registry_header size 32 {
    magic:                u64 @ 0;
    format_version:       u32 @ 8;
    component_count:      u32 @ 12;
    next_sequence:        u64 @ 16;
    payload_crc32c:       u32 @ 24;
    _reserved:            u32 @ 28;
}

record component_root_record size 72 {
    magic:                u64 @ 0;
    format_version:       u32 @ 8;
    _reserved:            u32 @ 12;
    module_id:            object-ref @ 16;
    captable_id:          object-ref @ 32;
    state_id:             object-ref @ 48;
    payload_crc32c:       u32 @ 64;
    _padding:             u32 @ 68;
}

record component_captable_header size 32 {
    magic:                u64 @ 0;
    format_version:       u32 @ 8;
    slot_count:           u32 @ 12;
    next_object_sequence: u64 @ 16;
    payload_crc32c:       u32 @ 24;
    _reserved:            u32 @ 28;
}

record instance_state_header size 64 {
    magic:                u64 @ 0;
    format_version:       u32 @ 8;
    header_size:          u32 @ 12;
    logical_time:         u64 @ 16;
    timer_deadline:       u64 @ 24;
    timer_armed:          u32 @ 32;
    mailbox_used:         u32 @ 36;
    memory_size:          u64 @ 40;
    payload_crc32c:       u32 @ 48;
    _reserved:            u32 @ 52;
    _padding:             u64 @ 56;
}

record service_binding size 112 {
    magic: u64 @ 0;
    format: u32 @ 8;
    reserved: u32 @ 12;
    owner: object-ref @ 16;
    module: object-ref @ 32;
    previous_module: object-ref @ 48;
    state_schema: u64 @ 64;
    message_mask: u64 @ 72;
    generation: u64 @ 80;
    previous_messages: u64 @ 88;
    state_offset: u32 @ 96;
    state_size: u32 @ 100;
    crc: u32 @ 104;
    padding: u32 @ 108;
}

// Interface 1: message bit 0 is a ping; state schema 1 is this counter.
record service_ping size 8 {
    kind: u32 @ 0;
    reserved: u32 @ 4;
}

record service_counter_state size 16 {
    count: u64 @ 0;
    slot: i32 @ 8;
    reserved: u32 @ 12;
}
