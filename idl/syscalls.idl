syscall log(message: slice<u8>) -> i32;
syscall object_create(type: type-id, size: u32) -> i32;
syscall object_read(slot: cap, offset: u32, buffer: out slice<u8>) -> i32;
syscall object_write(slot: cap, offset: u32, buffer: slice<u8>) -> i32;
syscall object_size(slot: cap) -> i64;
syscall cap_drop(slot: cap) -> i32;
syscall cap_derive(parent: cap, rights: u32, badge: u32) -> i32;
syscall cap_revoke(slot: cap) -> i32;
syscall message_send(target: cap, payload: slice<u8>, capability: cap?) -> i32;
syscall message_send_cap(target: cap, payload: slice<u8>, capability: cap?, rights: u32, badge: u32) -> i32;
syscall provenance(slot: cap, age: u32, buffer: out slice<u8>) -> i32;
syscall stats(buffer: out slice<u8>) -> i32;
syscall trace(age: u32, buffer: out slice<u8>) -> i32;
syscall message_recv(buffer: out slice<u8>, capability_out: out i32) -> i32;
syscall timer_set(delay_ticks: u64) -> i32;
syscall time_logical() -> i64;
syscall self() -> i32;
syscall exit(code: i32);
syscall driver_request(buffer: out slice<u8>) -> i32;
syscall driver_complete(status: i32, buffer: slice<u8>) -> i32;
syscall dma_read(slot: cap, offset: u32, buffer: out slice<u8>) -> i32;
syscall dma_write(slot: cap, offset: u32, buffer: slice<u8>) -> i32;
syscall queue_submit(slot: cap, descriptors: slice<u8>) -> i32;
syscall driver_restart() -> i32;
